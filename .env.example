# Compose reads this file automatically for `docker compose up`.
# Copy it first:  cp .env.example .env

# Required. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Required. https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Optional. Without it reports have no sources.
TAVILY_API_KEY=

# Optional. Enables GET /api/metrics (bearer-token protected); unset = 404.
METRICS_TOKEN=
# Optional. How long a SIGTERM drain waits for running tasks before aborting.
SHUTDOWN_GRACE_MS=10000
