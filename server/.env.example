# PostgreSQL (docker compose default)
DATABASE_URL=postgresql://research:research_dev@localhost:5432/research_agent
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Auth (required). Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# DeepSeek (required). Model ids: deepseek-chat | deepseek-reasoner
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Tavily web search (optional). Without a key the pipeline still writes a
# report, it just cannot cite sources.
TAVILY_API_KEY=
# Override for local stubs / proxies; defaults to https://api.tavily.com
# TAVILY_BASE_URL=http://localhost:4999

# Optional. Enables GET /api/metrics (bearer-token protected); unset = 404.
METRICS_TOKEN=
# Optional. How long a SIGTERM drain waits for running tasks before aborting.
SHUTDOWN_GRACE_MS=10000
