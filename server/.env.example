# PostgreSQL (docker compose default)
DATABASE_URL=postgresql://research:research_dev@localhost:5432/research_agent
PORT=3000
WEB_ORIGIN=http://localhost:5173

# DeepSeek (required). Model ids: deepseek-chat | deepseek-reasoner
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Tavily web search (optional). Without a key the pipeline still writes a
# report, it just cannot cite sources.
TAVILY_API_KEY=
# Override for local stubs / proxies; defaults to https://api.tavily.com
# TAVILY_BASE_URL=http://localhost:4999
