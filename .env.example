# Compose reads this file automatically for `docker compose up`.
# Copy it first:  cp .env.example .env

# Required. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Required. https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Optional. Without it reports have no sources.
TAVILY_API_KEY=
